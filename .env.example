# Copy to .env (read by docker compose and scripts/dev.*). Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Postgres (docker compose) -------------------------------------------------------
POSTGRES_USER=materials
POSTGRES_PASSWORD=change-me
POSTGRES_DB=materials
# Host port of the compose Postgres, used by host-side development (scripts/dev.*).
# Change it (and DATABASE_URL) if a local Postgres already uses 5433.
POSTGRES_PORT=5433
# Host-side tools connect through the published port:
DATABASE_URL=postgresql+psycopg://materials:change-me@127.0.0.1:5433/materials

# --- Auth: HS256 JWTs signed by the community platform (no user store here) ----------
PLATFORM_JWT_SECRET=change-me-to-the-secret-shared-with-the-community-platform
# Audience required when a token has an "aud" claim; issuer is checked only if set.
PLATFORM_JWT_AUDIENCE=materials-db
# PLATFORM_JWT_ISSUER=lightsmith-community

# --- Branding and URLs -----------------------------------------------------------------
BRAND_NAME=Lightsmith Materials
LIBRARY_NAME=Lightsmith
PUBLIC_BASE_URL=http://localhost:8100
API_PORT=8100
# Interface the API is published on; 0.0.0.0 exposes it to the network.
API_BIND=127.0.0.1
# Extra CORS origins, comma-separated; localhost:3000 and :5173 are always allowed.
# CORS_ORIGINS=https://lightsmith.example

# --- Data import ------------------------------------------------------------------------
# refractiveindex.info database commit imported by the importer job.
RII_COMMIT=c5c2f188e848453def5970e347399d653df2ffc2
CROSSREF_ENABLED=true
# A contact address puts DOI lookups in Crossref's polite pool.
# CROSSREF_MAILTO=you@example.org

# Upload size limit for submissions (bytes).
# MAX_UPLOAD_BYTES=5000000
